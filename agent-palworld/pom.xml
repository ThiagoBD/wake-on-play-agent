<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.wakeonplay</groupId>
    <artifactId>agents-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>agent-palworld</artifactId>
  <!-- Versão própria: cada agente tem seu ciclo de release (tag palworld-vX.Y.Z) -->
  <version>0.1.0-SNAPSHOT</version>
  <name>Wake on Play - Agent Palworld</name>

  <properties>
    <agent.mainClass>com.wakeonplay.agent.palworld.PalworldAgent</agent.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.wakeonplay</groupId>
      <artifactId>agent-core</artifactId>
      <!-- o core segue a versão do parent, não a do agente -->
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- gera target/agent-palworld.jar -->
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${agent.mainClass}</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
